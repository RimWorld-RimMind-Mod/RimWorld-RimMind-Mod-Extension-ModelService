<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMind.ModelService.Tests</RootNamespace>
    <AssemblyName>RimMindModelService.Tests</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../RimMind-Core/Source/Domain/RimMindCore.Domain.csproj" />
    <ProjectReference Include="../../RimMind-Core/Source/Application/RimMindCore.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="VerseStubs.cs" />
    <Compile Include="Contracts\**\*.cs" />
    <Compile Include="..\..\RimMind-Core\TestSupport\ContractCaseRunner.cs"
             Link="Support\ContractCaseRunner.cs" />
    <Compile Include="../Source/Models/ProviderType.cs" />
    <Compile Include="../Source/Models/ModelEndpointConfig.cs" />
    <Compile Include="../Source/Models/ModelEndpointPresets.cs" />
    <Compile Include="../Source/Client/EnvironmentEndpointOverlay.cs" />
    <Compile Include="../Source/Settings/ModelServiceSettings.cs" />
    <Compile Include="../Source/Security/LocalLoopbackValidator.cs" />
    <Compile Include="../Source/Security/SecretRedactor.cs" />
    <Compile Include="../Source/Balancing/LoadBalancer.cs" />
    <Compile Include="../Source/Protocol/IModelProtocol.cs" />
    <Compile Include="../Source/Protocol/ModelProtocolRegistry.cs" />
    <Compile Include="../Source/Protocol/OpenAIProtocolAdapter.cs" />
    <Compile Include="../Source/Protocol/AnthropicProtocolAdapter.cs" />
    <Compile Include="../Source/Client/ModelServiceClient.cs" />
    <Compile Include="../Source/Client/ModelServiceClientFactory.cs" />
    <Compile Include="../Source/Client/OpenCodeGoClientFactory.cs" />
    <Compile Include="../Source/Diagnostics/EndpointHealthProbe.cs" />
  </ItemGroup>

  <!-- Test-only links to Core's internal OpenAI serializer and log sanitizer: the parity contracts
       compare ModelService's wire output against Core's directly so the two cannot drift. -->
  <ItemGroup>
    <Compile Include="../../RimMind-Core/Source/Infrastructure/Services/Clients/OpenAI/MessageDto.cs" Link="CoreParity\MessageDto.cs" />
    <Compile Include="../../RimMind-Core/Source/Infrastructure/Services/Clients/OpenAI/OpenAIRequestSerializer.cs" Link="CoreParity\OpenAIRequestSerializer.cs" />
    <Compile Include="../../RimMind-Core/Source/Infrastructure/Services/Clients/Shared/LogSanitizer.cs" Link="CoreParity\LogSanitizer.cs" />
  </ItemGroup>

</Project>
